{
    "manifest_version": 3,
    "name": "Railway Ticket Bot",
    "version": "1.0",
    "description": "Automates ticket booking on eticket.railway.gov.bd",
    "permissions": [
        "tabs",
        "activeTab",
        "scripting",
        "storage"
    ],
    "host_permissions": [
        "https://eticket.railway.gov.bd/*"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "Railway Ticket Bot"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://eticket.railway.gov.bd/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ]
}